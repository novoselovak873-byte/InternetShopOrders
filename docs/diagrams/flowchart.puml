@startuml
start

:Менеджер регистрирует нового клиента в БД;
:Программа создаёт карточку клиента;

:Получить данные заказа с сайта;

if (Товар есть на складе?) then (да)
  :Временно забронировать товар в БД;
  if (Статус заказа = "Оплачен"?) then (да)
    :Статус = "В сборке";
    :Отправить список товаров на склад;
    :Собрать и отправить заказ;
    if (Пришёл статус "Заказ вручён"?) then (да)
      :Записать прибыль в БД;
      :Статус = "Выполнен";
      stop
    else (отказ)
      :Вернуть товар на склад (+1 к остаткам);
      :Статус = "Возврат";
      stop
    endif
  else (нет)
    :Отменить бронь;
    :Статус = "Отменён";
    stop
  endif
else (нет)
  :Статус = "Отменён";
  stop
endif

@enduml