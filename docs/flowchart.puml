@startuml
start

:Получить данные заказа с сайта;

if (Товары есть на складе?) then (да)
  :Забронировать товары на складе;
  if (Заказ оплачен?) then (да)
    :Собрать и отправить заказ;
    if (Заказ вручён успешно?) then (да)
      :Зафиксировать прибыль в БД;
      :Статус = "Выполнен";
      stop
    else (нет)
      :Вернуть товар на склад (+1 к остаткам);
      :Статус = "Возврат";
      stop
    endif
  else (нет)
    :Снять бронь;
    :Статус = "Отменён";
    stop
  endif
else (нет)
  :Статус = "Отменён";
  stop
endif

@enduml